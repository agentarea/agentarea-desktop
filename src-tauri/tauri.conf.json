{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentArea",
  "version": "0.1.1",
  "identifier": "com.jamakase.agentarea-desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AgentArea",
        "width": 1040,
        "height": 720,
        "minWidth": 760,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Run Claude Code and Codex with AgentArea tools, or delegate to cloud agents",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEzN0Q3NDNCMDcxRjM4N0IKUldSN09COEhPM1I5RThNUFkwWFF5TG4wVldUUkVxOVNmS0o5UGg5NTVPVS9NU1M4N01JdVBYV2YK",
      "endpoints": [
        "https://github.com/agentarea/agentarea-desktop/releases/latest/download/latest.json"
      ]
    }
  }
}
